{
  "name": "@peter.naydenov/visual-controller-for-svelte5",
  "description": "Use it when a single javascript application should control multiple Svelte 5 apps.",
  "version": "3.0.1",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./src/main.js",
  "types": "./dist/main.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/visual-controller-for-svelte5.esm.mjs",
      "require": "./dist/visual-controller-for-svelte5.cjs",
      "default": "./dist/visual-controller-for-svelte5.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run types",
    "preview": "vite preview",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "types": "tsc -p tsconfig.types.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/visual-controller-for-svelte5.git"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "ask-for-promise": "^3.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
